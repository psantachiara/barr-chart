dino:graphicValue rdfs:isDefinedBy <https://psantachiara.github.io/dino/ns> .
dino:positionOnScale rdfs:isDefinedBy <https://psantachiara.github.io/dino/ns> .
dino:positionAcross rdfs:isDefinedBy <https://psantachiara.github.io/dino/ns> .
