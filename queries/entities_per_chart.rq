# Every entity written on each chart, with its wording there and whether the chart's conventions make it external.
# Identity across charts comes from the modeller's skos:exactMatch, in the interpretation graph.
PREFIX dino:   <https://psantachiara.github.io/dino/ns#>
PREFIX barr:   <https://psantachiara.github.io/barr-chart/ns#>
PREFIX crm:    <http://www.cidoc-crm.org/cidoc-crm/>
PREFIX skos:   <http://www.w3.org/2004/02/skos/core#>
PREFIX skosxl: <http://www.w3.org/2008/05/skos-xl#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?chart ?entity ?type ?label ?external WHERE {
  GRAPH ?g { ?chart crm:P65_shows_visual_item ?d . ?d dino:expresses ?scheme .
             ?c skos:inScheme ?scheme ; skosxl:prefLabel ?l . ?l skosxl:literalForm ?label }
  GRAPH <https://psantachiara.github.io/barr-chart/graph/interpretation> { ?c skos:exactMatch ?entity . ?entity a ?type . FILTER (?type != skos:Concept) }
  OPTIONAL { GRAPH <https://psantachiara.github.io/barr-chart/graph/derived> { ?l dino:signifies barr:external } BIND (true AS ?external) }
}
