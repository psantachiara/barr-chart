    <https://psantachiara.github.io/barr-chart/chart/p21/convention/underline> a dino:Convention ;
        skos:note "The underlined label is the conceptual anchor of what is written with it." ;
        dino:appliesTo dino:LabelMark ;
        dino:basis dino:inferredByAnalyst ;
        dino:graphicValue dino:underline ;
        dino:holdsFor <https://psantachiara.github.io/barr-chart/chart/p21/diagram> ;
        dino:signifies dino:title .

    <https://psantachiara.github.io/barr-chart/chart/p21/convention/verticalPosition> a dino:Convention ;
